# /etc/systemd/system/groupbuy.service
[Unit]
Description=FreshCircle group-buying marketplace (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=groupbuy
Group=groupbuy
WorkingDirectory=/opt/groupbuy
EnvironmentFile=/opt/groupbuy/.env
ExecStart=/opt/groupbuy/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/groupbuy/instance /opt/groupbuy/backups

[Install]
WantedBy=multi-user.target
