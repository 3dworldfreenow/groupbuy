# Copy to .env and edit. NEVER commit the real .env file.

# development | production | testing
FLASK_ENV=development
FLASK_APP=run.py

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite is used for local development when DATABASE_URL is empty.
# Production example (PostgreSQL):
#   DATABASE_URL=postgresql://groupbuy:CHANGE_ME@localhost:5432/groupbuy
DATABASE_URL=

# Market configuration (development default: India / INR)
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹

# Uploads are stored outside the static folder and served only after an
# authorization check. Leave empty to use instance/uploads.
UPLOAD_FOLDER=
MAX_UPLOAD_MB=5

# Set to 1 when running behind a reverse proxy (Nginx, Caddy) that sets
# X-Forwarded-* headers.
BEHIND_PROXY=0

# Set to 0 only if you serve production over plain HTTP (not recommended).
SESSION_COOKIE_SECURE=1

# Contact details shown on the Contact page
CONTACT_EMAIL=support@example.com

# Optional: shared secret for a future payment gateway webhook (HMAC-SHA256).
# Leave empty to keep the gateway webhook disabled.
PAYMENT_WEBHOOK_SECRET=
